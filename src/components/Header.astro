---
import { SITE_DATA, SERVICES } from "../data/site";
const whatsappPhone = SITE_DATA.phones.find((p) => p.hasWhatsapp);
---

<header class="site-header" id="header">
  <!-- Topbar informativa -->
  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-left">
        <span class="topbar-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          {SITE_DATA.address.street}, {SITE_DATA.address.building} · {SITE_DATA.address.city}
        </span>
      </div>
      <div class="topbar-right">
        {SITE_DATA.phones.map((phone) => (
          <a
            href={phone.hasWhatsapp ? phone.whatsappUrl : `tel:+34${phone.raw}`}
            target={phone.hasWhatsapp ? "_blank" : undefined}
            rel={phone.hasWhatsapp ? "noopener noreferrer" : undefined}
            class="topbar-phone"
            title={phone.label}
          >
            {phone.hasWhatsapp ? (
              <svg class="wa-icon" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/><path d="M12 2C6.486 2 2 6.486 2 12c0 1.828.494 3.541 1.352 5.018L2 22l5.132-1.347A9.956 9.956 0 0 0 12 22c5.514 0 10-4.486 10-10S17.514 2 12 2zm0 18c-1.577 0-3.095-.456-4.397-1.318l-.315-.208-3.046.799.814-2.967-.229-.327A7.953 7.953 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/></svg>
            ) : (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            )}
            <span>{phone.number}</span>
            {phone.hasWhatsapp && <span class="wa-pill">WhatsApp</span>}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Navegación principal -->
  <div class="container nav-container">
    <a href="/" class="brand" aria-label="Fervi Asesores - Ir a Inicio">
      <img src="/img/logo.png" alt="Fervi Asesores" width="180" height="50" />
    </a>

    <button class="menu-toggle" aria-label="Abrir menú de navegación" aria-expanded="false" id="menu-toggle">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/">Inicio</a></li>
        <li><a href="/quienes-somos">Quiénes somos</a></li>
        <li class="has-dropdown">
          <a href="/#servicios" class="dropdown-trigger">
            Servicios
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
          <ul class="dropdown-menu">
            {SERVICES.map((service) => (
              <li>
                <a href={`/servicios/${service.slug}`}>
                  <span class="dropdown-title">{service.shortTitle}</span>
                  <span class="dropdown-badge">{service.badge}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>

      <div class="nav-actions">
        {whatsappPhone && (
          <a
            href={whatsappPhone.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/><path d="M12 2C6.486 2 2 6.486 2 12c0 1.828.494 3.541 1.352 5.018L2 22l5.132-1.347A9.956 9.956 0 0 0 12 22c5.514 0 10-4.486 10-10S17.514 2 12 2zm0 18c-1.577 0-3.095-.456-4.397-1.318l-.315-.208-3.046.799.814-2.967-.229-.327A7.953 7.953 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/></svg>
            Consúltanos
          </a>
        )}
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("main-nav");
  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      nav.classList.toggle("is-open");
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #FFFFFF;
    box-shadow: var(--shadow-sm);
  }

  .topbar {
    background-color: var(--color-primary);
    color: #FFFFFF;
    font-size: 0.85rem;
    padding: 0.45rem 0;
  }

  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .topbar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .topbar-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #FFFFFF;
    font-weight: 600;
  }

  .topbar-phone:hover {
    color: #A3E4B5;
  }

  .wa-icon {
    color: var(--color-whatsapp);
  }

  .wa-pill {
    background: var(--color-cta);
    color: #FFFFFF;
    font-size: 0.7rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-weight: 700;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 78px;
  }

  .brand img {
    max-height: 48px;
    width: auto;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 1.75rem;
  }

  .nav-list a {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.98rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-list a:hover {
    color: var(--color-cta);
  }

  /* Dropdown Servicios */
  .has-dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 270px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: 0.6rem;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: var(--transition);
  }

  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-menu li a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-sm);
    gap: 0.15rem;
  }

  .dropdown-menu li a:hover {
    background: var(--color-bg-alt);
  }

  .dropdown-title {
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.93rem;
  }

  .dropdown-badge {
    font-size: 0.75rem;
    color: var(--color-secondary);
    font-weight: 500;
  }

  .btn-sm {
    padding: 0.6rem 1.2rem;
    font-size: 0.92rem;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2.5px;
    background: var(--color-primary);
    border-radius: 2px;
  }

  @media (max-width: 900px) {
    .topbar-left {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .main-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #FFFFFF;
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem;
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      display: none;
    }
    .main-nav.is-open {
      display: flex;
    }
    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      padding-left: 1rem;
    }
  }
</style>