---
import { SITE_DATA, SERVICES } from "../data/site";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <!-- Columna 1: Marca y Redes Sociales -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-logo">
        <img src="/img/logo-monocromo.png" alt="Fervi Asesores" width="170" height="48" />
      </a>
      <p class="footer-desc">
        Asesoría integral y soluciones de ahorro para particulares y empresas en El Ejido y provincia: seguros, energía, telecomunicaciones, servicios jurídicos, informática y finanzas.
      </p>
      <div class="social-links" aria-label="Redes sociales de Fervi Asesores">
        <a
          href={SITE_DATA.socials.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Síguenos en Instagram"
          class="social-btn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          <span>Instagram</span>
        </a>
        <a
          href={SITE_DATA.socials.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Síguenos en Facebook"
          class="social-btn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          <span>Facebook</span>
        </a>
      </div>
    </div>

    <!-- Columna 2: Servicios -->
    <div class="footer-col">
      <h3 class="footer-heading">Áreas de Servicio</h3>
      <ul class="footer-links">
        {SERVICES.map((service) => (
          <li>
            <a href={`/servicios/${service.slug}`}>{service.shortTitle}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Columna 3: Navegación -->
    <div class="footer-col">
      <h3 class="footer-heading">Empresa</h3>
      <ul class="footer-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/quienes-somos">Quiénes somos</a></li>
        <li><a href="/contacto">Contacto y Cómo llegar</a></li>
        <li><a href="/contacto#mapa">Ubicación en El Ejido</a></li>
      </ul>
    </div>

    <!-- Columna 4: Contacto Directo -->
    <div class="footer-col">
      <h3 class="footer-heading">Contacto Directo</h3>
      <ul class="footer-contact">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>{SITE_DATA.address.full}</span>
        </li>
        {SITE_DATA.phones.map((phone) => (
          <li>
            {phone.hasWhatsapp ? (
              <div class="phone-group">
                <a href={`tel:+34${phone.raw}`} class="contact-link">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  <span>{phone.number}</span>
                </a>
                <a
                  href={phone.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wa-badge-link"
                  title="Escribir por WhatsApp al 850 985 066"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/><path d="M12 2C6.486 2 2 6.486 2 12c0 1.828.494 3.541 1.352 5.018L2 22l5.132-1.347A9.956 9.956 0 0 0 12 22c5.514 0 10-4.486 10-10S17.514 2 12 2zm0 18c-1.577 0-3.095-.456-4.397-1.318l-.315-.208-3.046.799.814-2.967-.229-.327A7.953 7.953 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/></svg>
                  WhatsApp
                </a>
              </div>
            ) : (
              <a href={`tel:+34${phone.raw}`} class="contact-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
                <span>{phone.number}</span>
              </a>
            )}
          </li>
        ))}
        <li>
          <a href={`mailto:${SITE_DATA.email}`} class="contact-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>{SITE_DATA.email}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Barra Legal Inferior -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {currentYear} {SITE_DATA.name}. Todos los derechos reservados.</p>
      <ul class="legal-links">
        <li><a href="/aviso-legal">Aviso Legal</a></li>
        <li><a href="/politica-de-privacidad">Política de Privacidad</a></li>
        <li><a href="/politica-de-cookies">Política de Cookies</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary-dark);
    color: rgba(255, 255, 255, 0.85);
    padding-top: 4.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.4fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
  }

  .footer-logo img {
    filter: brightness(0) invert(1);
    margin-bottom: 1rem;
  }

  .footer-desc {
    font-size: 0.94rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
    color: rgba(255, 255, 255, 0.78);
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    font-size: 0.88rem;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .social-btn:hover {
    background: var(--color-cta);
    border-color: var(--color-cta);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .footer-heading {
    color: #FFFFFF;
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-heading::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 36px;
    height: 3px;
    background: var(--color-cta);
    border-radius: 2px;
  }

  .footer-links,
  .footer-contact {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a,
  .contact-link {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.94rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .footer-links a:hover,
  .contact-link:hover {
    color: #FFFFFF;
    transform: translateX(3px);
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.94rem;
  }

  .phone-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .wa-badge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(37, 211, 102, 0.18);
    color: #4CE884;
    border: 1px solid rgba(37, 211, 102, 0.4);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .wa-badge-link:hover {
    background: var(--color-whatsapp);
    color: #FFFFFF;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.5rem 0;
    font-size: 0.88rem;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .legal-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .legal-links a {
    color: rgba(255, 255, 255, 0.75);
  }

  .legal-links a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>