---
import Factura from "./Factura.astro";
import { SITE_DATA } from "../data/site";

const mainPhone = SITE_DATA.phones[0];
---

<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-content">
      <span class="eyebrow">Asesoría Integral y Ahorro en El Ejido</span>
      <h1>Revisamos lo que pagas cada mes y lo dejamos en lo justo.</h1>
      <p class="hero-lead">
        Optimizamos tus contratos de <strong>seguros, luz, telecomunicaciones, servicios jurídicos, informática y finanzas</strong>. Analizamos tu caso sin compromiso para que ahorres mes a mes, sin letra pequeña.
      </p>

      <div class="hero-actions">
        <a href="/contacto" class="btn btn-primary">
          Solicita tu estudio gratuito
        </a>
        <a href={`tel:+34${mainPhone.raw}`} class="btn btn-outline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Llamar al {mainPhone.number}
        </a>
      </div>

      <div class="hero-trust">
        <div class="trust-item">
          <span class="trust-dot"></span>
          <span>Estudio 100% sin coste</span>
        </div>
        <div class="trust-item">
          <span class="trust-dot"></span>
          <span>Atención presencial en Edificio CIM (El Ejido)</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <Factura />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 4.5rem 0 5rem;
    background: radial-gradient(circle at 85% 20%, rgba(227, 34, 25, 0.06), transparent 45%),
                linear-gradient(180deg, #FFFFFF 0%, #F4F5F7 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-content h1 {
    font-size: clamp(2.1rem, 4.2vw, 3.1rem);
    color: var(--color-primary);
    margin-bottom: 1.2rem;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-size: 1.12rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .trust-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-cta);
  }

  @media (max-width: 920px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-section {
      padding: 3rem 0 3.5rem;
    }
  }
</style>