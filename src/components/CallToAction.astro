---
import { SITE_DATA } from "../data/site";
const mainPhone = SITE_DATA.phones[0];
---

<section class="cta-section section">
  <div class="container">
    <div class="cta-box">
      <div class="cta-content">
        <span class="eyebrow cta-badge">Estudio Gratuito</span>
        <h2>¿Cuánto puedes ahorrar en tus facturas cada mes?</h2>
        <p>
          Tráenos tus recibos de luz, seguros o telefonía a nuestra oficina en El Ejido o envíanoslos por WhatsApp. Analizamos tus costes actuales sin compromiso.
        </p>
      </div>

      <div class="cta-actions">
        <a href="/contacto" class="btn btn-primary cta-main-btn">
          Solicita tu estudio gratuito
        </a>
        <div class="cta-phone-group">
          <a href={`tel:+34${mainPhone.raw}`} class="btn btn-outline cta-sec-btn">
            Llamar al {mainPhone.number}
          </a>
          <a
            href={mainPhone.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp cta-sec-btn"
          >
            Escribirnos por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background-color: var(--color-bg-alt);
  }

  .cta-box {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    color: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 3.5rem 3rem;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: center;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cta-badge {
    background: rgba(227, 34, 25, 0.25) !important;
    color: #FF8B85 !important;
    border-color: rgba(227, 34, 25, 0.4) !important;
  }

  .cta-content h2 {
    color: #FFFFFF;
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    margin-bottom: 1rem;
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cta-main-btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.05rem;
  }

  .cta-phone-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .cta-sec-btn {
    width: 100%;
    font-size: 0.9rem;
    padding: 0.75rem 0.5rem;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    color: #FFFFFF !important;
  }

  .cta-sec-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: #FFFFFF;
  }

  .cta-sec-btn.btn-whatsapp {
    background: var(--color-whatsapp);
    border-color: var(--color-whatsapp);
  }

  .cta-sec-btn.btn-whatsapp:hover {
    background: #1EBE57;
  }

  @media (max-width: 900px) {
    .cta-box {
      grid-template-columns: 1fr;
      padding: 2.5rem 1.5rem;
      gap: 2rem;
    }
    .cta-phone-group {
      grid-template-columns: 1fr;
    }
  }
</style>