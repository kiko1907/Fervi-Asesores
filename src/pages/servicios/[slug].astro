---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
import { SERVICES, SITE_DATA, type ServiceItem } from "../../data/site";

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
---

<BaseLayout
  title={`${service.title} en El Ejido | ${SITE_DATA.name}`}
  description={service.description}
>
  <!-- Hero del Servicio -->
  <section class="service-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/#servicios">Servicios</a>
        <span>/</span>
        <span aria-current="page">{service.shortTitle}</span>
      </nav>
      <span class="eyebrow">{service.badge}</span>
      <h1>{service.title}</h1>
      <p class="hero-subtitle">{service.subtitle}</p>
    </div>
  </section>

  <!-- Contenido Principal + Sidebar con Formulario -->
  <section class="section">
    <div class="container service-layout">
      <!-- Columna de Contenido Enriquecido -->
      <div class="service-main">
        <div class="intro-block">
          <h2>Asesoramiento experto y sin letra pequeña</h2>
          <p class="long-desc">{service.longDescription}</p>
        </div>

        <!-- Soluciones Específicas del Servicio -->
        <div class="features-block">
          <h3>¿Qué incluye nuestro servicio de {service.shortTitle.toLowerCase()}?</h3>
          <div class="features-grid">
            {service.features.map((feat) => (
              <div class="feature-card card">
                <div class="feature-check">✓</div>
                <h4>{feat.title}</h4>
                <p>{feat.description}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Ventajas Competitivas -->
        <div class="benefits-box">
          <h3>¿Por qué gestionar tus {service.shortTitle.toLowerCase()} con Fervi Asesores?</h3>
          <ul class="benefits-list">
            {service.benefits.map((benefit) => (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Preguntas Frecuentes del Servicio -->
        <div class="faq-block">
          <h3>Preguntas frecuentes sobre {service.shortTitle}</h3>
          <div class="faq-list">
            {service.faqs.map((faq) => (
              <details class="faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- Columna Lateral Sticky: Formulario y WhatsApp -->
      <aside class="service-sidebar">
        <div class="sticky-card card">
          <span class="sidebar-badge">Estudio 100% Gratuito</span>
          <h3>Solicita tu revisión de {service.shortTitle}</h3>
          <p>Déjanos tus datos y analizamos tu caso sin ningún compromiso de permanencia.</p>
          <ContactForm />
        </div>

        <div class="wa-helper-card">
          <h4>¿Prefieres enviarnos tu factura o póliza por WhatsApp?</h4>
          <p>Escríbenos directamente a nuestro teléfono con WhatsApp y te respondemos enseguida.</p>
          <a
            href={SITE_DATA.phones[0].whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp full-width"
          >
            WhatsApp: 850 985 066
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Otros servicios relacionados -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="other-title">Otras áreas en las que podemos ayudarte a ahorrar</h2>
      <div class="other-grid">
        {otherServices.map((item) => (
          <a href={`/servicios/${item.slug}`} class="other-card card">
            <h4>{item.shortTitle}</h4>
            <p>{item.description}</p>
            <span class="more-link">Ver servicio →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: #FFFFFF;
    padding: 4rem 0 3.5rem;
  }

  .breadcrumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.88rem;
    margin-bottom: 1.25rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .breadcrumbs a {
    color: #FFFFFF;
  }

  .service-hero .eyebrow {
    background: rgba(47, 168, 79, 0.25);
    color: #A9F5BC;
    border: 1px solid rgba(47, 168, 79, 0.5);
  }

  .service-hero h1 {
    color: #FFFFFF;
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 0.85rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    max-width: 750px;
    color: rgba(255, 255, 255, 0.92);
  }

  .service-layout {
    display: grid;
    grid-template-columns: 1.35fr 0.95fr;
    gap: 3rem;
    align-items: start;
  }

  .intro-block h2 {
    margin-bottom: 1rem;
  }

  .long-desc {
    font-size: 1.06rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .features-block h3,
  .faq-block h3 {
    margin-bottom: 1.25rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .feature-card {
    padding: 1.5rem;
  }

  .feature-check {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--color-cta-light);
    color: var(--color-cta);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
  }

  .feature-card h4 {
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
  }

  .feature-card p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .benefits-box {
    background: var(--color-secondary-light);
    border-left: 4px solid var(--color-secondary);
    padding: 2rem;
    border-radius: var(--radius-md);
    margin-bottom: 2.5rem;
  }

  .benefits-box h3 {
    margin-bottom: 1.1rem;
  }

  .benefits-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .benefits-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-weight: 500;
  }

  .benefits-list svg {
    color: var(--color-cta);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1.1rem 1.35rem;
    background: #FFFFFF;
  }

  .faq-item summary {
    font-weight: 700;
    color: var(--color-primary);
    cursor: pointer;
  }

  .faq-item p {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .service-sidebar {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sidebar-badge {
    display: inline-block;
    background: var(--color-cta-light);
    color: var(--color-cta);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }

  .sticky-card h3 {
    margin-bottom: 0.4rem;
  }

  .sticky-card > p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .wa-helper-card {
    background: var(--color-primary);
    color: #FFFFFF;
    padding: 1.5rem;
    border-radius: var(--radius-md);
  }

  .wa-helper-card h4 {
    color: #FFFFFF;
    margin-bottom: 0.4rem;
  }

  .wa-helper-card p {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1rem;
  }

  .full-width {
    width: 100%;
  }

  .other-title {
    text-align: center;
    margin-bottom: 2rem;
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .other-card h4 {
    margin-bottom: 0.5rem;
  }

  .other-card p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .more-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-cta);
  }

  @media (max-width: 950px) {
    .service-layout {
      grid-template-columns: 1fr;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
    .service-sidebar {
      position: static;
    }
  }
</style>